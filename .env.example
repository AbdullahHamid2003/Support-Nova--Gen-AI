# SupportNova configuration - copy to `.env` (git-ignored) and adjust.
# Every value has a working development default, so the app runs with no .env at all.
# Secrets are read only by the FastAPI server; nothing here is ever sent to the React frontend.
# Optional: keep secrets (AI_API_KEY, SECRET_KEY, ...) in a separate `.env.secrets` file next to
# `.env` (also git-ignored). It is read after `.env` and overrides it.

# ---- Application -------------------------------------------------------------
APP_ENV=development                 # development | test | production
# Signs the session tokens. Blank = a development-only key; APP_ENV=production refuses to start without a
# random value of 32+ characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=480
COOKIE_SECURE=false                 # true behind HTTPS (the session cookie is HttpOnly + SameSite=Lax)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVE_FRONTEND=true                 # serve the built React app (frontend/dist) from FastAPI

# ---- Database (PostgreSQL) -----------------------------------------------------
# Local dev cluster from tools/devdb (port 5433); docker-compose uses host "db" and port 5432.
DATABASE_URL=postgresql+psycopg://supportnova:postgres@127.0.0.1:5433/supportnova
DB_ECHO=false

# ---- GenAI - Pipeline 1 -----------------------------------------------------------
# AI_PROVIDER = openai | anthropic | gemini (or "real" to infer the vendor from the key/model).
# AI_API_KEY authenticates it and never leaves the server - keep it in .env.secrets, not here.
# Without a key the GenAI step reports "not configured": no AI output is produced and every complaint
# goes to manual review with the Python rule-matrix decision.
AI_PROVIDER=openai
AI_API_KEY=
# AI_MODEL empty = provider default (openai: gpt-4.1-mini, anthropic: claude-opus-5, gemini: gemini-2.5-flash).
# AI_BASE_URL = optional API gateway / proxy.
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2                    # corrective retries after an invalid structured response
AI_TEMPERATURE=0.1                  # OpenAI / Gemini only; Claude requests do not send sampling parameters
AI_MAX_OUTPUT_TOKENS=4096
AI_EFFORT=medium                    # Claude only: low | medium | high | xhigh | max
AI_REFUSAL_FALLBACK=true            # Claude only: server-side refusal fallbacks (beta)

# ---- Embeddings / retrieval --------------------------------------------------------
EMBEDDING_PROVIDER=local            # local (hybrid BM25 + hashed vectors, no key) | openai | gemini
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Optional external vector store - not required (retrieval runs inside PostgreSQL).
VECTOR_DATABASE_URL=
RETRIEVAL_TOP_K=10

# ---- Background work ------------------------------------------------------------------
# Optional; an in-process worker pool is used when empty.
REDIS_URL=
BACKGROUND_WORKERS=2
# Dataset import and evaluation runs: customers processed at the same time (each customer's complaints stay
# in date order). Every complaint makes two GenAI calls - keep this within the AI vendor's rate limits.
BATCH_WORKERS=4
SLA_MONITOR_INTERVAL_SECONDS=60

# ---- Limits -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_MB=15
MAX_ATTACHMENT_MB=5

# ---- Complaint processing -------------------------------------------------------------------
DUPLICATE_WINDOW_HOURS=24
REJECT_EXACT_DUPLICATES=true
NEAR_DUPLICATE_THRESHOLD=0.86
REPEAT_SIMILARITY_THRESHOLD=0.30

# ---- First-run setup ------------------------------------------------------------------------
AUTO_MIGRATE=true                   # apply Alembic migrations on startup
AUTO_SEED=true                      # roles, Rule Matrix, prompts, knowledge base
# Import the synthetic complaint dataset when the DB is empty and run every complaint through the full
# pipeline - two GenAI calls per complaint on the configured model (paid API usage on the first start).
SEED_DATASET_ON_STARTUP=true
SEED_DEMO_USERS=true                # one demo login per role - disable for anything but a demo
SEED_SIMULATE_LIFECYCLE=true        # labelled "simulated history" for old demo complaints
# Password of every demo account. Blank = the documented demo password Lumora#Demo2026 (demo only).
DEMO_PASSWORD=
