flowchart TB
  PROB["Manual handling: slow triage,<br/>missed escalations, unsupported<br/>promises, no traceability"]
  KB[("Knowledge Base<br/>24 documents, 29 versions")]
  subgraph SN["SupportNova"]
    C["Complaint submitted<br/>by a customer or agent"]
    PRE["Pre-processing and<br/>RAG policy retrieval"]
    G1["Pipeline 1 - GenAI analysis<br/>gpt-4.1-mini, JSON schema"]
    V1["Pipeline 2 - Rule Matrix<br/>decision and AI checks"]
    G2["Pipeline 1 - response from<br/>the validated decision"]
    V2["Pipeline 2 - response checks<br/>and verification score"]
  end
  RM[("Rule Matrix<br/>276 rules")]
  OPS["Escalation, follow-up, SLA<br/>records and audit trail"]
  VER["Verified: response<br/>ready for the agent"]
  REV["Manual review queue:<br/>a reviewer decides"]
  PROB -->|"addressed by"| PRE
  C --> PRE
  KB --> PRE
  PRE --> G1
  G1 -->|"proposal"| V1
  RM --> V1
  V1 -->|"validated decision"| G2
  V1 --> OPS
  G2 -->|"draft"| V2
  V2 -->|"Verified"| VER
  V2 -->|"Manual Review"| REV
  subgraph LEG["Legend"]
    LG1["GenAI step"]
    LG2["Deterministic Python"]
    LG3["Data"]
    LG4["People"]
    LG5["Problem"]
  end
  REV ~~~ LG3
