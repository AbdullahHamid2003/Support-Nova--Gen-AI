flowchart TB
  USR["Customers and staff<br/>5 roles"]

  subgraph BRW["Browser"]
    SPA["React 19 single-page app<br/>served from frontend/dist"]
  end

  subgraph APP["FastAPI application"]
    API["REST API /api/v1<br/>middleware, RBAC, 95 routes"]
    SVC["Service layer<br/>+ background worker pool"]
    P1["Pipeline 1<br/>genai_pipeline"]
    P2["Pipeline 2<br/>python_validation, rule_engine"]
    KNL["Knowledge layer<br/>documents, retrieval"]
  end

  subgraph DAT["Data tier"]
    PG[("PostgreSQL 17<br/>35 tables")]
    FS[("storage/<br/>documents, attachments")]
  end

  LLM["GenAI provider API<br/>OpenAI gpt-4.1-mini"]

  USR --> SPA
  SPA -->|"JSON, cookie + CSRF"| API
  API --> SVC
  SVC --> P1
  SVC --> P2
  SVC --> KNL
  P1 -->|"HTTPS, server-side key"| LLM
  SVC --->|"SQLAlchemy"| PG
  KNL --> FS

  subgraph LEG["Legend"]
    L1["GenAI step"]
    L2["Deterministic Python"]
  end
