flowchart TB
  TPL["prompts.py + context.py<br/>versioned template, evidence,<br/>nonce-tagged complaint"]
  SC["schemas.py<br/>enums from live catalog"]
  RN["runner.py<br/>1 + AI_MAX_RETRIES attempts,<br/>errors sent back on retry"]
  LOG[("ai_runs table<br/>every attempt")]
  FAC["providers factory<br/>AI_PROVIDER, AI_MODEL"]
  OA["OpenAI adapter<br/>strict json_schema"]
  AN["Anthropic adapter<br/>output_config.format"]
  GM["Gemini adapter<br/>responseJsonSchema"]
  UC["No key<br/>not_configured"]
  VEND["Vendor API"]
  PS["parsing.py<br/>jsonschema + Pydantic"]
  PV2["Pipeline 2<br/>python_validation"]

  TPL --> RN
  SC --> RN
  RN --> FAC
  RN --> LOG
  FAC --> OA
  FAC --> AN
  FAC --> GM
  FAC --> UC
  OA --> VEND
  AN --> VEND
  GM --> VEND
  VEND -->|"JSON text"| PS
  PS -->|"ComplaintAnalysis"| PV2

  subgraph LEG["Legend"]
    L1["GenAI component"]
    L2["Deterministic Python"]
  end
  PV2 ~~~ L1

  class TPL,SC,RN,FAC,PS,OA,AN,GM,L1 genai
  class PV2,L2 rules
  class LOG data
  class VEND ext
  class UC risk
