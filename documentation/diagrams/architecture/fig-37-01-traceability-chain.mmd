flowchart TB
  CMP["Complaint<br/>complaints, complaint_history"]
  ANA["AI analysis<br/>analyses: model, prompt<br/>version and sha256"]
  RUL["Rule Matrix decision<br/>selected rule, fired rules,<br/>ruleset hash"]
  RUN["Every AI attempt<br/>ai_runs: request, raw reply"]
  EVI["Policy evidence<br/>policy_references"]
  VAL["Validation and comparison<br/>validation_results,<br/>validation_checks"]
  RES["Resolution<br/>AI vs validated steps"]
  ESC["Escalation<br/>level, rule IDs, source"]
  REV["Manual review<br/>original and final snapshots"]
  RSP["Customer response<br/>version, status, checks"]
  AUD[("Audit log<br/>append-only, hash-chained")]
  VIEW["Evaluator views<br/>case report PDF, timeline,<br/>AI vs rules, AI runs"]
