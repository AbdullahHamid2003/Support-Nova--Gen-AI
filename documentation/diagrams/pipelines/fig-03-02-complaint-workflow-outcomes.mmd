flowchart TB
  CMP["Comparison Engine result<br/>from Figure 3.1"]
  VI["Validated intelligence<br/>rule-enforced decision"]
  RES["Resolution steps<br/>and eligibility"]
  ESC["Escalation, follow-up<br/>and SLA timers"]
  GENR["GenAI customer response<br/>from the validated decision"]
  DEC("Response checks,<br/>score and decision")
  SEND["Agent sends the<br/>validated response"]
  REV["Manual review queue<br/>approve, modify, reclassify,<br/>regenerate, reject"]
  REC[("Audit trail, analytics<br/>and reports")]

  CMP --> VI
  VI --> RES
  VI --> ESC
  VI --> GENR --> DEC
  DEC -->|"Verified"| SEND
  DEC -->|"Manual Review"| REV
  RES --> REC
  ESC --> REC
  SEND --> REC
  REV --> REC

  subgraph LEG["Legend"]
    L1["GenAI step"]
    L2["Deterministic Python"]
  end
  REC ~~~ L1

