flowchart TB
  ADM["Administrator uploads<br/>PDF or DOCX + metadata"]
  FV["File validation<br/>type, size, SHA-256 duplicate"]
  PAR["Parsing<br/>PyMuPDF, python-docx"]
  MET["Metadata validation<br/>ID, version, dates, type"]
  SEC["Section extraction<br/>number, heading, pages"]
  CHK["Chunking<br/>chunk ID, vector, facts"]
  INJ["Instruction screen<br/>quarantine suspicious chunks"]
  VER["Version control<br/>Active, Previous, Superseded"]
  IDX["Retrieval index<br/>rebuilt on kb_revision"]
  KB[("Approved Knowledge Base")]
  REJ["Rejected with<br/>a clear message"]
  PG[("PostgreSQL rows and<br/>storage/documents file")]

  ADM --> FV --> PAR --> MET --> SEC --> CHK --> INJ --> VER --> IDX --> KB
  FV -.->|"invalid or duplicate"| REJ
  MET -.->|"invalid"| REJ
  VER -.-> PG

  class FV,PAR,MET,SEC,CHK,INJ,VER,IDX rules
  class KB,PG data
  class ADM human
  class REJ risk
classDef genai fill:#EEF0FF,stroke:#4F46E5,color:#1E1B4B,stroke-width:1.5px
classDef rules fill:#E7F6EC,stroke:#15803D,color:#052E16,stroke-width:1.5px
classDef data fill:#E6F1FB,stroke:#0369A1,color:#082F49
classDef ext fill:#F3F4F6,stroke:#4B5563,color:#111827
classDef human fill:#FEF3E2,stroke:#B45309,color:#431407
classDef ui fill:#FFFFFF,stroke:#334155,color:#0F172A
classDef risk fill:#FDECEC,stroke:#B91C1C,color:#450A0A
