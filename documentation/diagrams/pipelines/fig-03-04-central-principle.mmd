flowchart TB
  IN["Complaint + approved evidence"]
  SN["SupportNova<br/>GenAI proposes. Python validates.<br/>Ground truth decides."]

  subgraph P1["GenAI Intelligence Pipeline"]
    G1["GenAI analysis<br/>structured JSON proposal"]
  end

  subgraph P2["Ground-Truth Validation"]
    R1["Deterministic perception<br/>signals, entities, category"]
    R2["Rule Matrix decision<br/>routing, urgency, escalation,<br/>eligibility, actions"]
  end

  CE{"Comparison Engine<br/>+ validation checks"}
  V["Verified<br/>case continues"]
  M["Mismatch, risk or doubt<br/>manual review"]

  IN --> SN
  SN --> G1
  SN --> R1 --> R2
  G1 -->|"proposal"| CE
  R2 -->|"ground truth"| CE
  CE -->|"score at least 80,<br/>no critical failure,<br/>no review trigger"| V
  CE -->|"otherwise"| M

  subgraph LEG["Legend"]
    L1["GenAI step"]
    L2["Deterministic Python"]
  end
  M ~~~ L1

