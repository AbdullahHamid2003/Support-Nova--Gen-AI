flowchart TB
  subgraph R1["Step 1: Scenarios"]
    direction LR
    SB[("Scenario bank<br/>17 YAML files,<br/>412 scenarios")]
    DR["Draft instances<br/>date, customer,<br/>channel, product"]
    LED["Order ledger<br/>35 order profiles,<br/>catalog prices"]
    SB --> DR --> LED
  end

  subgraph R2["Step 2: Text and facts"]
    direction LR
    REN["Slot rendering<br/>facts registered,<br/>channel wrapper"]
    IDS["Chronological IDs<br/>CMP- dev, EVL- holdout"]
    DEC[("Declared facts<br/>signals, facts,<br/>history, order")]
    REN --> IDS --> DEC
  end

  subgraph R3["Step 3: Labels and checks"]
    direction LR
    RM[("Rule Matrix<br/>rules/*.yaml")]
    LAB["Reference labeller<br/>label_declared"]
    CHK["Checks<br/>intended rule, coherence,<br/>uniqueness"]
    RM --> LAB --> CHK
  end

  subgraph R4["Step 4: Files and use"]
    direction LR
    OUT[("Dataset files<br/>617 dev, 154 holdout,<br/>summary JSON")]
    VALD["validate_dataset.py<br/>PASS=78, FAIL=0"]
    USE["Seed import (dev)<br/>and evaluation (holdout)"]
    OUT --> VALD --> USE
  end

  R1 --> R2 --> R3 --> R4

  class DR,LED,REN,IDS,LAB,CHK,VALD,USE rules
  class SB,DEC,RM,OUT data
