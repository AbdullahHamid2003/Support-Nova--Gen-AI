flowchart TB
  START["Attempt n<br/>at most 1 + AI_MAX_RETRIES = 3"]
  CALL["Provider call<br/>request plus any correction"]
  LOG[("ai_runs<br/>one row per attempt")]
  VALIDATE["Validate the reply<br/>extract_json, jsonschema<br/>Draft 2020-12, Pydantic"]
  ACC["Accepted output<br/>stage result ok"]
  RETRYQ["Retry decision<br/>attempts left and error<br/>retryable (Table 8.6)?"]
  MR["Stage failed<br/>SCH-001 fails, REV-009,<br/>Manual Review, rules apply"]
  START --> CALL
  CALL -.- LOG
  CALL -->|"reply"| VALIDATE
  CALL -->|"provider error"| RETRYQ
  VALIDATE -->|"valid"| ACC
  VALIDATE -->|"invalid output"| RETRYQ
  RETRYQ -->|"yes, pause and correct"| START
  RETRYQ -->|"no"| MR
  subgraph LEG["Legend"]
    L1["GenAI"]
    L2["Python"]
    L3["Data"]
    L4["Human"]
  end
  MR ~~~ L1
  MR ~~~ L2
  MR ~~~ L3
  MR ~~~ L4
  class CALL,ACC,L1 genai
  class START,VALIDATE,RETRYQ,L2 rules
  class LOG,L3 data
  class MR,L4 human
