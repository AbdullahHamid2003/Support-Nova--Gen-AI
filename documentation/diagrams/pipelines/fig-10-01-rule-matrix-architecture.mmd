flowchart TB
  KBS[("Knowledge base<br/>24 documents, 29 versions")]
  YAML[("rules/ and config/<br/>YAML baseline")]
  KBB["KB build check<br/>must-state facts and<br/>routing table = routing rules"]
  DB[("Table rules<br/>276 rules, 14 config rows")]
  RM["RuleMatrix<br/>integrity-checked, hashed,<br/>cached by revision"]
  DE["DecisionEngine<br/>Pipeline 2"]
  SIM["Simulator and<br/>reference labeler"]
  RET["Rule-guided retrieval<br/>of KB sections"]
  GEN["GenAI Pipeline 1<br/>vocabulary only"]
  KBS --> KBB
  YAML --> KBB
  YAML -->|"seed or reset"| DB
  DB --> RM
  RM --> DE
  RM --> SIM
  RM --> RET
  RM -.->|"codes, levels,<br/>priority matrix"| GEN
  subgraph LEGEND["Legend"]
    L1["GenAI"]
    L2["Deterministic Python"]
    L3["Data store"]
  end
  SIM ~~~ L1
  RET ~~~ L2
  GEN ~~~ L3
  class GEN,L1 genai
  class KBB,RM,DE,SIM,RET,L2 rules
  class KBS,YAML,DB,L3 data
