flowchart TB
  OVR{"Reviewer<br/>reclassified?"}
  CONF{"Rule classifier high<br/>or medium confidence<br/>and not ambiguous?"}
  VALID{"AI subcategory valid<br/>and among the rule<br/>classifier candidates?"}
  R1["reviewer_override"]
  R2["python_rules<br/>rules classification"]
  R3["ai_unconfirmed<br/>AI subcategory, provisional"]
  R4["python_low_confidence<br/>rules best match"]
  REV["REV-005 ambiguous_complaint<br/>always Manual Review"]
  OVR -->|"yes"| R1
  OVR -->|"no"| CONF
  CONF -->|"yes"| R2
  CONF -->|"no"| VALID
  VALID -->|"yes"| R3
  VALID -->|"no"| R4
  R3 --> REV
  R4 --> REV
  class OVR,CONF,VALID,R2,R4 rules
  class R3 genai
  class R1,REV human
