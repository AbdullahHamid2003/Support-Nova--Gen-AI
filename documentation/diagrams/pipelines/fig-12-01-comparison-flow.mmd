flowchart TB
  OWN["Rule classifier result<br/>own subcategory"]
  DEC["Rules decision"]
  AI["GenAI analysis output"]
  ROWS["build_comparison<br/>18 field rows"]
  CHK["Phase A checks<br/>judge the same fields"]
  SC["Scalar fields<br/>match or mismatch"]
  LS["List fields as sets<br/>match, partial, mismatch"]
  AGR["Agreement = share<br/>of matching rows"]
  FLAG[("ai_python_agreement<br/>category, department,<br/>escalation")]
  VR[("validation_results<br/>comparison")]
  UI["AI vs rules tab<br/>and Analytics KPI"]
  OWN --> ROWS
  DEC --> ROWS
  AI --> ROWS
  DEC --> CHK
  AI --> CHK
  ROWS --> SC
  ROWS --> LS
  SC --> AGR
  LS --> AGR
  ROWS -->|"3 key fields"| FLAG
  AGR --> VR --> UI
  FLAG --> UI
  subgraph LEGEND["Legend"]
    L1["GenAI"]
    L2["Deterministic Python"]
    L3["Data store"]
  end
  UI ~~~ L1
  UI ~~~ L2
  UI ~~~ L3
