flowchart TB
  REF["Reference subcategory"]
  RR[("Routing rule<br/>RTE-001 to RTE-035")]
  PRI["Rules primary<br/>department"]
  FINAL[("department_code =<br/>rules primary")]
  SUP["Rules supporting departments<br/>routing, rule, secondary issues,<br/>conditional, escalation"]
  AI["GenAI department and<br/>supporting departments"]
  C1{"Check RTE-001<br/>same primary?"}
  C2{"Check RTE-002<br/>required supporting<br/>departments covered?"}
  PASS["Pass"]
  FAIL["Fail, critical<br/>REV-002"]
  MR["Manual Review"]
  P2["All: pass, some: warn,<br/>none: fail"]
  REF --> RR --> PRI
  PRI --> FINAL
  PRI --> C1
  AI --> C1
  PRI --> SUP
  SUP --> C2
  AI --> C2
  C1 -->|"yes"| PASS
  C1 -->|"no"| FAIL --> MR
  C2 --> P2
  class REF,PRI,SUP,C1,C2,PASS,P2 rules
  class RR,FINAL data
  class AI genai
  class FAIL risk
  class MR human
classDef genai fill:#EEF0FF,stroke:#4F46E5,color:#1E1B4B,stroke-width:1.5px
