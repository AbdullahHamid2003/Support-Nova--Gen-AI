flowchart TB
  ATK["Browser or API client<br/>untrusted request"]
  RC["RequestContextMiddleware<br/>request ID, CSP, headers"]
  CO["CORSMiddleware<br/>CORS_ORIGINS allow-list"]
  RL["RateLimitMiddleware<br/>240 per min, login 20"]
  LG["POST /auth/login<br/>bcrypt, lockout 5 x 5 min"]
  JWT["Session cookie sn_access<br/>HS256 JWT, HttpOnly, Lax"]
  CSRF["CSRF check on writes<br/>cookie equals header"]
  RB["RBAC guard<br/>5 roles, 27 permissions"]
  EP["Route handler<br/>and service layer"]
  ERR["Error handlers<br/>no stack traces"]
  AUD[("Hash-chained audit log<br/>append-only trigger")]
  KEY[("Server-only secret<br/>SECRET_KEY")]

  ATK --> RC --> CO --> RL --> LG --> JWT --> CSRF --> RB --> EP
  RB -->|"403 denied"| ERR
  ERR -->|"access.denied"| AUD
  EP --> AUD
  KEY -.->|"signs"| JWT

  class ATK risk
  class RC,CO,RL,LG,JWT,CSRF,RB,EP,ERR rules
  class AUD,KEY data
