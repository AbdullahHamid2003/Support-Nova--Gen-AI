flowchart TB
  TXT["Complaint text<br/>untrusted data"]
  DOC["Uploaded document<br/>untrusted data"]
  NRM["Normalisation<br/>NFKC, invisible chars, HTML"]
  INJ["Injection screen<br/>patterns, base64, fake IDs"]
  PII["PII redaction<br/>cards, passwords, codes"]
  NON["Nonce-tagged complaint<br/>element in the prompt"]
  GEN["GenAI analysis<br/>and response"]
  VAL["Python validation<br/>SEC-001, SEC-002, RSP-006"]
  REV["Manual review<br/>REV-010 and others"]
  UPV["Upload validation<br/>magic bytes, macros, size"]
  QUA["Chunk quarantine<br/>never used as evidence"]
  KEY[("Server-only secret<br/>AI_API_KEY")]

  TXT --> NRM --> INJ --> PII --> NON --> GEN --> VAL
  INJ -->|"suspicious"| REV
  VAL -->|"check failed"| REV
  DOC --> UPV --> QUA
  KEY -.-> GEN

  subgraph LEG["Legend"]
    L1["GenAI step"]
    L2["Deterministic Python"]
  end
  REV ~~~ L1

  class TXT,DOC risk
  class NRM,INJ,PII,NON,VAL,UPV,QUA,L2 rules
  class GEN,L1 genai
  class REV human
  class KEY data
classDef genai fill:#EEF0FF,stroke:#4F46E5,color:#1E1B4B,stroke-width:1.5px
classDef rules fill:#E7F6EC,stroke:#15803D,color:#052E16,stroke-width:1.5px
classDef data fill:#E6F1FB,stroke:#0369A1,color:#082F49
classDef ext fill:#F3F4F6,stroke:#4B5563,color:#111827
classDef human fill:#FEF3E2,stroke:#B45309,color:#431407
classDef ui fill:#FFFFFF,stroke:#334155,color:#0F172A
classDef risk fill:#FDECEC,stroke:#B91C1C,color:#450A0A
