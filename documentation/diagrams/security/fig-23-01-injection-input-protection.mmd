flowchart TB
  RMX[("Rule Matrix and<br/>reference data")]
  KB[("Knowledge Base:<br/>active, clean chunks")]
  ATK["Embedded attack:<br/>ignore rules, fake note"]
  SYS["System prompt:<br/>trusted instructions"]
  EVD["Evidence: the only<br/>citable policy source"]
  CMPL["Complaint text<br/>untrusted input"]
  SCN["Normalise and screen:<br/>28 patterns and more"]
  PREP["Mark flagged spans,<br/>redact cards, passwords"]
  REV["Manual review<br/>REV-010"]
  UNC["Complaint element<br/>with a random nonce"]
  LLM["GenAI analysis<br/>strict JSON schema"]

  ATK -.->|"hidden in"| CMPL
  CMPL --> SCN --> PREP --> UNC --> LLM
  SCN -->|"suspicious"| REV
  RMX --> SYS --> LLM
  KB --> EVD --> LLM

