flowchart LR
  subgraph ATK["Attacks tested"]
    A1["Prompt injection,<br/>fake system messages"]
    A2["Fake or outdated<br/>policy references"]
    A3["Unsupported refund or<br/>compensation demands"]
    A4["Card numbers and<br/>passwords in text"]
    A5["Malicious document<br/>MAL-DOC-99"]
    A6["Executable or<br/>oversized uploads"]
    A7["No session, wrong role,<br/>no CSRF token"]
    A8["UPDATE or DELETE<br/>on audit_logs"]
  end
  subgraph CTL["Controls exercised"]
    C1["Injection screening<br/>security/injection.py"]
    C2["PII redaction<br/>security/pii.py"]
    C3["Python validation checks<br/>SEC, SCH, POL, ELG, RSP"]
    C4["Upload validation,<br/>chunk quarantine"]
    C5["Auth, RBAC, CSRF,<br/>lockout, rate limit"]
    C6["Append-only trigger,<br/>hash chain"]
  end
  subgraph OUT["Outcome"]
    O1["Manual Review<br/>never auto-verified"]
    O2["Request refused<br/>401, 403, 422, 429"]
    O3["Change blocked<br/>chain still valid"]
  end
  A1 --> C1
  A2 --> C1
  A1 --> C3
  A2 --> C3
  A3 --> C3
  A4 --> C2
  A4 --> C3
  A5 --> C4
  A6 --> C4
  A7 --> C5
  A8 --> C6
  C1 --> O1
  C2 --> O1
  C3 --> O1
  C4 --> O2
  C5 --> O2
  C6 --> O3
